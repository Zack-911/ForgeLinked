  "description": "A package to extend forgescript to implement music capabilities via lavalink",
  "main": "dist/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\"",
